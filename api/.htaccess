# Beskyt config.php (inkl. backup-/editor-filer som config.php.bak / config.php~)
# og auth.php mod direkte HTTP-adgang (issue #18).
<FilesMatch "^(config\.php|auth\.php)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
