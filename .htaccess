# Zacharias Polonius — zpolonius.dk

# Forhindr mappe-visning og MultiViews
Options -Indexes -MultiViews

# Custom 404 side
ErrorDocument 404 /404

# --- SIKKERHEDS HEADERS ---
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

RewriteEngine On
RewriteBase /

# 1. Tving HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect index.html til root
RewriteRule ^index\.html$ / [R=301,L]

# 3. Rene URL'er til detail-sider (Før extension hiding)
RewriteRule ^projects/([^/]+)/?$ detail.html?id=$1 [L,QSA]
RewriteRule ^projekter/([^/]+)/?$ detail.html?id=$1 [L,QSA]
RewriteRule ^insights/([^/]+)/?$ detail.html?id=$1 [L,QSA]
RewriteRule ^artikler/([^/]+)/?$ detail.html?id=$1 [L,QSA]
RewriteRule ^cv/([^/]+)/?$ detail.html?id=$1 [L,QSA]
RewriteRule ^recommendations/([^/]+)/?$ detail.html?id=$1 [L,QSA]
RewriteRule ^anbefalinger/([^/]+)/?$ detail.html?id=$1 [L,QSA]

# 4. Skjul .html fil-endelser (External redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html
RewriteRule ^/?(.*)\.html$ /$1 [L,R=301]

# 5. Intern rewrite til .html filer
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 6. Dynamisk Sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Blokér adgang til følsomme filer
<FilesMatch "(wp-config\.php|\.env|migrate\.php|generate-hash\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# --- CACHING ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Content Security Policy
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.quilljs.com cdn.jsdelivr.net cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdn.quilljs.com cdn.jsdelivr.net; font-src 'self' fonts.gstatic.com; img-src 'self' data:; connect-src 'self' generativelanguage.googleapis.com cdn.jsdelivr.net; frame-src 'self' open.spotify.com;"
</IfModule>
